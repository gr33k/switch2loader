' Read-only slot-0 source checker; run this SLOT 1 only.
VAR N=PRGSIZE(0),C=0,H=0,G=0,I,J,S$,B
IF N<1 OR N>400 THEN PRINT "BAD SIZE",N:END
PRGEDIT 0
FOR I=1 TO N
 S$=PRGGET$()
 C=C+LEN(S$)
 FOR J=0 TO LEN(S$)-1
  B=ASC(S$[J])
  H=(H*31+B) MOD 1000003
  G=(G*37+B) MOD 1000033
 NEXT
 H=(H*31+10) MOD 1000003
 G=(G*37+10) MOD 1000033
NEXT
PRINT "LINES",N,"CHARS",C,"H1",H,"H2",G
END
